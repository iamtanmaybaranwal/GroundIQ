# ---------------------------------------------------------------------------
# LexiQuery configuration. Copy to `.env` and fill in.
# The DEFAULT STACK RUNS FULLY OFFLINE - no API key is required to run, test or
# evaluate this project. The keys below only matter if you switch a provider.
# ---------------------------------------------------------------------------

LEXIQUERY_CORPUS_PATH=corpus
LEXIQUERY_INDEX_PATH=artifacts/index

# ==> API KEY: protects the /v1 endpoints of the service.
LEXIQUERY_API_KEY=change-me-lexiquery-api-key

# ---------------------------------------------------------------- providers
# local  = TF-IDF + SVD embeddings computed on your corpus (default, offline)
# openai = hosted embeddings, requires LEXIQUERY_OPENAI_API_KEY below
LEXIQUERY_EMBEDDING_PROVIDER=local
LEXIQUERY_EMBEDDING_DIMENSION=192

# feature       = explainable offline reranker (default)
# cross-encoder = hosted reranker, requires LEXIQUERY_RERANK_API_KEY below
LEXIQUERY_RERANKER=feature

# extractive = grounded sentence selection (default, offline, deterministic)
# anthropic  = Claude via the official SDK, requires ANTHROPIC_API_KEY
# openai     = any OpenAI-compatible endpoint, requires LEXIQUERY_OPENAI_API_KEY
LEXIQUERY_ANSWERER=extractive

# ---------------------------------------------------------------- optional keys
# ==> API KEY (optional): Anthropic, used when LEXIQUERY_ANSWERER=anthropic
ANTHROPIC_API_KEY=

# ==> API KEY (optional): OpenAI-compatible, used for hosted embeddings/answers
LEXIQUERY_OPENAI_API_KEY=
LEXIQUERY_OPENAI_BASE_URL=https://api.openai.com/v1

# ==> API KEY (optional): hosted reranker (Cohere or compatible)
LEXIQUERY_RERANK_API_KEY=
LEXIQUERY_RERANK_URL=https://api.cohere.com/v1/rerank

# ---------------------------------------------------------------- retrieval
LEXIQUERY_CANDIDATES_PER_RETRIEVER=25
LEXIQUERY_RRF_K=60
LEXIQUERY_RERANK_WEIGHT=0.5
LEXIQUERY_TOP_K=5
LEXIQUERY_CONTEXT_TOKEN_BUDGET=1800

# ---------------------------------------------------------------- guardrails
# Below these the system refuses to answer instead of guessing.
LEXIQUERY_MIN_COVERAGE=0.34
LEXIQUERY_MIN_VECTOR_SCORE=0.35
